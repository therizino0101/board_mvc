<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- NOTE: <mapper>로 감싸지 않거나, <DOCTYPE>을 지정하지 않으면 에러가 난다.-->
<mapper namespace="board">
    <!-- insert문, parameterType은 어떤 DTO를 사용해서 데이터를 넘기는지 알려주기 위함.-->
    <!-- 생성된 id값을 받으려면 usGeneratedKeys, keyProperties를 적어야됨.-->
    <insert id="insertBoard" useGeneratedKeys="true" keyProperty="postId">
    <!-- board.insertBoard -->     
        INSERT INTO TB_POST(title, content)
        VALUES(#{title}, #{content})
    </insert>

    <select id="findById" resultType="com.example.board.model.Post">
    <!-- board.findById -->     
        SELECT *
        FROM TB_POST
        WHERE 1=1
        AND POST_ID = #{id}
        AND DEL_YN = 'N'
    </select>

    <select id="findBoardInfoById" resultType="com.example.board.model.Post">
    <!-- board.findBoardInfoById --> 
        SELECT
            ID
            , TITLE
            , CONTENT
        FROM TB_BOARD
        WHERE 1=1
        AND ID = #{ID}
        <!-- 로직으로 삭제된 글은 조회하지 않는다. -->
        AND DEL_YN = 'N'
    </select>

    <select id="countBoardById" resultType = "Integer">
        SELECT
            COUNT(*)
        FROM TB_BOARD
        WHERE 1=1
        AND ID = #{id}
        AND DEL_YN = 'N'
    </select>

    <select id="findAll" resultType="com.example.board.dto.BoardDTO">
    <!-- board.findAll --> 
        SELECT
            ID
            , TITLE
            , CONTENT
        FROM TB_BOARD
        WHERE 1=1
        AND DEL_YN = 'N'
    </select>

    <update id="updateBoard">
    <!-- board.updateBoard -->
        UPDATE TB_BOARD
        SET
            TITLE = #{title}
            , CONTENT = #{content}
        WHERE 1=1
        AND ID = #{id}
        AND DEL_YN = 'N'
    </update>

    <delete id="deleteBoard">
    <!-- board.deleteBoard -->
        UPDATE TB_BOARD
        SET DEL_YN = 'Y'
        WHERE ID = #{id}
        AND DEL_YN = 'N'
    </delete>
</mapper>