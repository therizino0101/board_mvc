<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="post">
    <resultMap id="postResultMap" type="com.example.stepboard.post.model.Post" >
        <id property="postId" column="post_id" />
        <result property="title" column="title" />
        <result property="content" column="content"/>
        <result property="regDt" column="reg_dt" />
        <result property="updDt" column="upd_dt" />
    </resultMap>

    <select id="findById" resultMap="postResultMap">
        SELECT
            POST_ID
            , TITLE
            , CONTENT
            , REG_DT
            , UPD_DT
        FROM TB_POST
        WHERE 1=1
        AND POST_ID = #{postId}
        AND DEL_YN = 'N'
    </select>

    <select id="findAll" resultMap = "postResultMap">
        SELECT
            POST_ID
            , TITLE
            , CONTENT
            , REG_DT
            , UPD_DT
        FROM TB_POST
        WHERE 1=1
        AND DEL_YN = 'N'
    </select>

    <insert id="insert"
            parameterType="com.example.stepboard.post.model.Post"
            useGeneratedKeys="true"
            keyProperty="postId"
            keyColumn="post_id"
    >
        INSERT INTO TB_POST (title, content)
        VALUES (#{title}, #{content})
    </insert>

    <update id="update"
            parameterType="com.example.stepboard.post.model.Post"
    >
        UPDATE TB_POST
        SET
            TITLE = #{title}
            , CONTENT = #{content}
            , UPD_DT = SYSUTCDATETIME()
        WHERE POST_ID = #{postId}
    </update>

    <delete id="deleteById">
        UPDATE TB_POST
        SET DEL_YN = 'Y'
        WHERE POST_ID = #{postId}
    </delete>


</mapper>